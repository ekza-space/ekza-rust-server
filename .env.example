# ---- network ----
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
STATIC_DIR=build

# Browser Origin allowlist. Applied to REST CORS *and* enforced on the Socket.IO
# handshake (a non-matching Origin gets 403). Comma-separated. Default: https://space.ekza.io
# Local UI against this server: add http://localhost:7103
# Never use "*" in production.
CORS_ALLOWED_ORIGINS=https://space.ekza.io

# ---- persistence ----
# Room state lives here as one JSON file per space (atomic writes). Mount a volume.
DATA_DIR=data

# ---- chain (authorization source of truth) ----
# Who may edit a space = current NFT holder (or on-chain editor) of that space id.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SPACE_PROGRAM_ID=2WtuXG6AX3erRp6eK5WiSTEEBec5zprQ7qLyLENfMQEH
# Seconds to trust a resolved holder before re-querying RPC.
OWNERSHIP_CACHE_SECS=30
# Optional ops wallets allowed to edit any room (comma-separated pubkeys).
MODERATOR_WALLETS=
